# ===== LUNA SELFbot — пример конфигурации =====
# Скопируй в .env и заполни:  cp .env.example .env

# --- Telegram (обязательно) ---
# Получить: https://my.telegram.org -> API development tools
API_ID=
API_HASH=

# --- AI (нужен ОДИН из ключей) ---
# Gemini:
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# OpenAI-совместимый (OpenAI/OpenRouter/DeepSeek/твой прокси):
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Поведение ---
TRIGGER_WORD=луна
JUDGE_TRIGGER=луна рассуди
MAX_REPLY_WORDS=250
ALLOW_SELF_REPLY=1

# --- Защита от бана ---
MIN_DELAY_SEC=0.8
MAX_DELAY_SEC=2.5
MAX_REPLIES_PER_MIN=6
DAILY_REPLY_LIMIT=200

# --- Файлы ---
SESSION_FILE=data/luna_session
STATE_FILE=data/luna_state.db

# DEBUG=1 для подробного лога
# DEBUG=0
